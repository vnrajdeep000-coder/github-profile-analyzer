{
  "info": {
    "name": "GitHub Profile Analyzer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for the GitHub Profile Analyzer."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/healthz",
            "description": "Returns 200 OK when the server is running."
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "Analyze Profile",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/analyze/:username",
            "description": "Fetch a GitHub user and store their analysis. Replace :username with a real GitHub handle.",
            "variable": [
              {
                "key": "username",
                "value": "torvalds"
              }
            ]
          }
        },
        {
          "name": "List All Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/profiles?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Returns all stored profiles with pagination."
          }
        },
        {
          "name": "Search Profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/profiles?search=torvalds&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"],
              "query": [
                { "key": "search", "value": "torvalds" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Search profiles by username or name."
          }
        },
        {
          "name": "Get Profile by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/profiles/:id",
            "description": "Returns a single profile by its numeric ID.",
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ]
          }
        }
      ]
    }
  ]
}
